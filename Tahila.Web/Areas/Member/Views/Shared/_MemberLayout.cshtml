@using Tahila.Application.Services.Interfaces
@inject ISiteSettingService SiteSettingService
@{ var settings = await SiteSettingService.GetSettingsAsync(); }
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] | @settings.SiteName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/tahila.css" asp-append-version="true"/>
</head>
<body>
<nav class="navbar-tahila">
    <div class="container d-flex align-items-center justify-content-between">
        <a href="/" class="logo">@settings.SiteName</a>
        <div class="d-flex align-items-center gap-3">
            <span style="color:var(--gray-light);font-size:.9rem"><i class="fas fa-user-circle me-1" style="color:var(--primary)"></i>@User.Identity?.Name</span>
            <form method="post" action="/account/logout" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" style="background:none;border:1px solid #333;color:var(--gray);padding:6px 14px;border-radius:20px;cursor:pointer;font-size:.85rem">خروج</button>
            </form>
        </div>
    </div>
</nav>

<div class="container" style="padding:40px 16px">
    @if (TempData["Success"] != null)
    { <div class="alert mb-4" style="background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:#22c55e;border-radius:12px;padding:12px 16px"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div> }
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
