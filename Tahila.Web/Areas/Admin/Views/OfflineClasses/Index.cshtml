@model IEnumerable<Tahila.Domain.Entities.OfflineClass>
@{ ViewData["PageTitle"] = "کلاس‌های آفلاین"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <span style="background:rgba(99,102,241,.1);color:#6366f1;padding:4px 14px;border-radius:20px;font-size:.8rem;font-weight:700">@Model.Count() دوره</span>
    <a href="/Admin/OfflineClasses/Create" class="btn-primary-tahila"><i class="fas fa-plus me-2"></i>دوره جدید</a>
</div>

<div class="row g-4">
@foreach (var c in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="tahila-card p-0" style="overflow:hidden">
            @if (!string.IsNullOrEmpty(c.ThumbnailUrl))
            { <img src="@c.ThumbnailUrl" style="width:100%;height:140px;object-fit:cover"/> }
            else
            { <div style="width:100%;height:140px;background:rgba(99,102,241,.08);display:flex;align-items:center;justify-content:center"><i class="fas fa-play-circle" style="font-size:2.5rem;color:#6366f1;opacity:.4"></i></div> }
            <div class="p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div style="font-weight:700">@c.Title</div>
                    @if (c.IsActive)
                    { <span class="badge-active" style="flex-shrink:0">فعال</span> }
                    else
                    { <span class="badge-inactive" style="flex-shrink:0">غیرفعال</span> }
                </div>
                <div style="color:var(--gray);font-size:.8rem;margin-bottom:.8rem">
                    <span style="background:rgba(99,102,241,.1);color:#6366f1;padding:2px 8px;border-radius:8px;font-size:.72rem">@c.Category</span>
                    <span class="ms-2">@c.Level</span>
                    <span class="ms-2"><i class="fas fa-play-circle me-1"></i>@c.Sessions.Count جلسه</span>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Admin/OfflineClasses/Sessions/@c.Id" class="btn-sm-outline" style="flex:1;text-align:center"><i class="fas fa-list me-1"></i>جلسات</a>
                    <a href="/Admin/OfflineClasses/Edit/@c.Id" class="btn-sm-outline"><i class="fas fa-edit"></i></a>
                    <form method="post" action="/Admin/OfflineClasses/Delete/@c.Id" onsubmit="return confirm('حذف شود؟')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-sm-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="col-12 text-center py-5" style="color:var(--gray)">
        <i class="fas fa-play-circle" style="font-size:2.5rem;opacity:.3"></i>
        <p class="mt-3">هنوز دوره‌ای ثبت نشده</p>
    </div>
}
</div>
