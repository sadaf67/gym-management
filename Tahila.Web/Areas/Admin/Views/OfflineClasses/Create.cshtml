@model Tahila.Domain.Entities.OfflineClass
@{ ViewData["PageTitle"] = "دوره جدید"; }

@section Styles {
<style>
.form-field{margin-bottom:1.4rem}.form-field label{display:block;font-weight:700;font-size:.88rem;margin-bottom:.5rem;color:var(--gray-light)}
.form-field input,.form-field select,.form-field textarea{width:100%;background:var(--dark-bg);border:1px solid var(--dark-border);border-radius:10px;padding:10px 14px;color:var(--white);font-family:Vazirmatn,sans-serif;font-size:.9rem;transition:border-color .2s}
.form-field input:focus,.form-field select:focus,.form-field textarea:focus{outline:none;border-color:var(--primary)}
.form-field select option{background:var(--dark-card)}
.toggle-check{display:flex;align-items:center;gap:10px;cursor:pointer}
.toggle-check input[type=checkbox]{width:20px;height:20px;accent-color:var(--primary)}
</style>
}

<a href="/Admin/OfflineClasses" style="color:var(--gray);font-size:.9rem;display:inline-block;margin-bottom:1.5rem"><i class="fas fa-arrow-right me-2"></i>بازگشت</a>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="tahila-card p-4">
                <div class="form-field"><label>عنوان دوره *</label><input name="Title" value="@Model.Title" required/></div>
                <div class="form-field"><label>توضیحات</label><textarea name="Description" rows="5">@Model.Description</textarea></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-field">
                            <label>دسته‌بندی</label>
                            <input name="Category" value="@Model.Category" placeholder="مثلاً: بدنسازی"/>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-field">
                            <label>سطح</label>
                            <select name="Level">
                                <option value="مبتدی" selected="@(Model.Level=="مبتدی")">مبتدی</option>
                                <option value="متوسط" selected="@(Model.Level=="متوسط")">متوسط</option>
                                <option value="پیشرفته" selected="@(Model.Level=="پیشرفته")">پیشرفته</option>
                                <option value="همه سطوح" selected="@(Model.Level=="همه سطوح")">همه سطوح</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-field"><label>نام مربی</label><input name="CoachName" value="@Model.CoachName"/></div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-field"><label>ترتیب نمایش</label><input type="number" name="Order" value="@Model.Order" min="0"/></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="tahila-card p-4 mb-4">
                <h6 style="font-weight:700;margin-bottom:1rem;color:var(--gray-light)">تصویر دوره</h6>
                <input type="file" name="thumbnailFile" accept="image/*" style="font-size:.85rem;margin-bottom:8px"/>
                <input name="ThumbnailUrl" value="@Model.ThumbnailUrl" placeholder="یا URL تصویر"/>
            </div>
            <div class="tahila-card p-4 mb-4">
                <h6 style="font-weight:700;margin-bottom:1rem;color:var(--gray-light)">وضعیت</h6>
                <label class="toggle-check">
                    <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")/>
                    <span>دوره فعال است</span>
                </label>
            </div>
            <button type="submit" class="btn-primary-tahila w-100"><i class="fas fa-save me-2"></i>ذخیره دوره</button>
        </div>
    </div>
</form>
