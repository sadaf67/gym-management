@model Tahila.Domain.Entities.ClassSession
@{ ViewData["PageTitle"] = "ویرایش جلسه"; }

@section Styles {
<style>
.form-field{margin-bottom:1.4rem}.form-field label{display:block;font-weight:700;font-size:.88rem;margin-bottom:.5rem;color:var(--gray-light)}
.form-field input,.form-field select,.form-field textarea{width:100%;background:var(--dark-bg);border:1px solid var(--dark-border);border-radius:10px;padding:10px 14px;color:var(--white);font-family:Vazirmatn,sans-serif;font-size:.9rem}
.form-field input:focus,.form-field textarea:focus{outline:none;border-color:var(--primary)}
.toggle-check{display:flex;align-items:center;gap:10px;cursor:pointer}
.toggle-check input[type=checkbox]{width:20px;height:20px;accent-color:var(--primary)}
</style>
}

<a href="/Admin/OfflineClasses/Sessions/@ViewBag.CourseId" style="color:var(--gray);font-size:.9rem;display:inline-block;margin-bottom:1.5rem">
    <i class="fas fa-arrow-right me-2"></i>بازگشت — @ViewBag.CourseName
</a>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id"/>
    <input type="hidden" name="OfflineClassId" value="@Model.OfflineClassId"/>
    <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("o")"/>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="tahila-card p-4">
                <div class="form-field"><label>عنوان جلسه *</label><input name="Title" value="@Model.Title" required/></div>
                <div class="form-field"><label>توضیحات</label><textarea name="Description" rows="4">@Model.Description</textarea></div>
                <div class="form-field">
                    <label>لینک ویدیو *</label>
                    <input name="VideoUrl" value="@Model.VideoUrl" required dir="ltr"/>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="tahila-card p-4 mb-4">
                <div class="form-field"><label>شماره جلسه</label><input type="number" name="SessionNumber" value="@Model.SessionNumber" min="1"/></div>
                <div class="form-field"><label>مدت (دقیقه)</label><input type="number" name="DurationMinutes" value="@Model.DurationMinutes" min="1"/></div>
                <div class="form-field"><label>ترتیب</label><input type="number" name="Order" value="@Model.Order" min="0"/></div>
            </div>
            <div class="tahila-card p-4 mb-4">
                <h6 style="font-weight:700;margin-bottom:1rem;color:var(--gray-light)">تصویر</h6>
                @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                { <img src="@Model.ThumbnailUrl" style="width:100%;border-radius:8px;margin-bottom:8px;max-height:100px;object-fit:cover"/> }
                <input type="file" name="thumbnailFile" accept="image/*" style="font-size:.85rem;margin-bottom:8px"/>
                <input name="ThumbnailUrl" value="@Model.ThumbnailUrl" placeholder="یا URL"/>
            </div>
            <div class="tahila-card p-4 mb-4">
                <div class="d-flex flex-column gap-3">
                    <label class="toggle-check">
                        <input type="checkbox" name="IsFree" value="true" @(Model.IsFree ? "checked" : "")/>
                        <span>🆓 جلسه رایگان</span>
                    </label>
                    <label class="toggle-check">
                        <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")/>
                        <span>جلسه فعال</span>
                    </label>
                </div>
            </div>
            <button type="submit" class="btn-primary-tahila w-100"><i class="fas fa-save me-2"></i>ذخیره تغییرات</button>
        </div>
    </div>
</form>
