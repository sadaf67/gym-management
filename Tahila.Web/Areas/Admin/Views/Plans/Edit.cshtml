@model Tahila.Domain.Entities.Plan
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["PageTitle"] = "ویرایش پلن"; }

<div class="tahila-card p-4" style="max-width:700px">
    <form method="post" class="form-tahila">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id"/>
        <input type="hidden" asp-for="CreatedAt"/>
        <div class="row g-3">
            <div class="col-md-6"><label>نام پلن *</label><input class="form-control" asp-for="Name" required/></div>
            <div class="col-md-3"><label>قیمت (تومان) *</label><input class="form-control" type="number" asp-for="Price" required/></div>
            <div class="col-md-3"><label>مدت (روز) *</label><input class="form-control" type="number" asp-for="DurationDays" required/></div>
            <div class="col-12"><label>توضیحات</label><input class="form-control" asp-for="Description"/></div>
            <div class="col-12"><label>امکانات (هر خط یک مورد)</label><textarea class="form-control" asp-for="Features" rows="5"></textarea></div>
            <div class="col-md-4"><label>ترتیب</label><input class="form-control" type="number" asp-for="Order"/></div>
            <div class="col-md-4 d-flex align-items-end pb-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsPopular" id="isPopular"/>
                    <label class="form-check-label" for="isPopular" style="color:var(--gray-light)">محبوب‌ترین</label>
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-end pb-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActive"/>
                    <label class="form-check-label" for="isActive" style="color:var(--gray-light)">فعال</label>
                </div>
            </div>
            <div class="col-12 d-flex gap-3 mt-2">
                <button type="submit" class="btn-primary-tahila"><i class="fas fa-save me-2"></i>ذخیره</button>
                <a href="/Admin/Plans" class="btn-outline-tahila">انصراف</a>
            </div>
        </div>
    </form>
</div>
