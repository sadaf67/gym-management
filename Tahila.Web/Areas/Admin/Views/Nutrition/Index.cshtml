@model IEnumerable<Tahila.Domain.Entities.NutritionArticle>
@{ ViewData["PageTitle"] = "مقالات تغذیه"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span style="background:rgba(34,197,94,.1);color:#22c55e;padding:4px 14px;border-radius:20px;font-size:.8rem;font-weight:700">@Model.Count() مقاله</span>
    </div>
    <a href="/Admin/Nutrition/Create" class="btn-primary-tahila"><i class="fas fa-plus me-2"></i>مقاله جدید</a>
</div>

<div class="tahila-card" style="overflow:hidden">
    <table class="table-tahila w-100">
        <thead>
            <tr>
                <th>تصویر</th>
                <th>عنوان</th>
                <th>دسته‌بندی</th>
                <th>نویسنده</th>
                <th>بازدید</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(a.ThumbnailUrl))
                    { <img src="@a.ThumbnailUrl" style="width:54px;height:40px;object-fit:cover;border-radius:8px"/> }
                    else
                    { <div style="width:54px;height:40px;background:rgba(34,197,94,.1);border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="fas fa-leaf" style="color:#22c55e;font-size:.8rem"></i></div> }
                </td>
                <td>
                    <div style="font-weight:700;max-width:240px">@a.Title</div>
                    <div style="color:var(--gray);font-size:.75rem;margin-top:2px">🕐 @a.ReadMinutes دقیقه مطالعه</div>
                    @if (a.IsFeatured) { <span style="background:rgba(245,158,11,.1);color:#f59e0b;font-size:.68rem;padding:2px 8px;border-radius:10px">⭐ ویژه</span> }
                </td>
                <td><span style="background:rgba(34,197,94,.1);color:#22c55e;padding:3px 10px;border-radius:12px;font-size:.8rem">@a.Category</span></td>
                <td style="color:var(--gray);font-size:.85rem">@a.AuthorName</td>
                <td style="color:var(--gray);font-size:.85rem"><i class="fas fa-eye me-1"></i>@a.ViewCount</td>
                <td>
                    @if (a.IsPublished)
                    { <span class="badge-active">منتشر</span> }
                    else
                    { <span class="badge-inactive">پیش‌نویس</span> }
                </td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="/nutrition/@a.Slug" target="_blank" class="btn-sm-outline" title="مشاهده"><i class="fas fa-eye"></i></a>
                        <a href="/Admin/Nutrition/Edit/@a.Id" class="btn-sm-outline"><i class="fas fa-edit"></i></a>
                        <form method="post" action="/Admin/Nutrition/Delete/@a.Id" onsubmit="return confirm('حذف شود؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--gray)">
            <i class="fas fa-newspaper" style="font-size:2.5rem;opacity:.3"></i>
            <p class="mt-3">هنوز مقاله‌ای ثبت نشده</p>
        </div>
    }
</div>
