@model Tahila.Domain.Entities.Transformation
@{ ViewData["PageTitle"] = "ویرایش داستان موفقیت"; }

@section Styles {
<style>
.form-field{margin-bottom:1.4rem}.form-field label{display:block;font-weight:700;font-size:.88rem;margin-bottom:.5rem;color:var(--gray-light)}
.form-field input,.form-field select,.form-field textarea{width:100%;background:var(--dark-bg);border:1px solid var(--dark-border);border-radius:10px;padding:10px 14px;color:var(--white);font-family:Vazirmatn,sans-serif;font-size:.9rem}
.form-field input:focus,.form-field textarea:focus,.form-field select:focus{outline:none;border-color:#f59e0b}
.form-field select option{background:var(--dark-card)}
.toggle-check{display:flex;align-items:center;gap:10px;cursor:pointer}
.toggle-check input[type=checkbox]{width:20px;height:20px;accent-color:#f59e0b}
</style>
}

<a href="/Admin/Transformations" style="color:var(--gray);font-size:.9rem;display:inline-block;margin-bottom:1.5rem"><i class="fas fa-arrow-right me-2"></i>بازگشت</a>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id"/>
    <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("o")"/>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="tahila-card p-4">
                <div class="row g-3">
                    <div class="col-md-6"><div class="form-field"><label>نام عضو</label><input name="MemberName" value="@Model.MemberName" required/></div></div>
                    <div class="col-md-6"><div class="form-field"><label>عنوان</label><input name="MemberTitle" value="@Model.MemberTitle"/></div></div>
                </div>
                <div class="form-field"><label>توضیحات</label><textarea name="Description" rows="4">@Model.Description</textarea></div>
                <div class="row g-3">
                    <div class="col-md-4"><div class="form-field"><label>کاهش وزن (kg)</label><input type="number" step="0.1" name="WeightLost" value="@Model.WeightLost" min="0"/></div></div>
                    <div class="col-md-4"><div class="form-field"><label>مدت (ماه)</label><input type="number" name="DurationMonths" value="@Model.DurationMonths" min="1"/></div></div>
                    <div class="col-md-4">
                        <div class="form-field"><label>هدف</label>
                            <select name="Goal">
                            @foreach (var g in new[]{"کاهش وزن","افزایش حجم","فرم‌دهی","سلامت عمومی"})
                            {
                                if (g == Model.Goal) { <option value="@g" selected="selected">@g</option> }
                                else { <option value="@g">@g</option> }
                            }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4"><div class="form-field"><label>BMI اول</label><input type="number" step="0.1" name="StartBmi" value="@Model.StartBmi"/></div></div>
                    <div class="col-md-4"><div class="form-field"><label>BMI آخر</label><input type="number" step="0.1" name="EndBmi" value="@Model.EndBmi"/></div></div>
                    <div class="col-md-4"><div class="form-field"><label>ترتیب</label><input type="number" name="Order" value="@Model.Order" min="0"/></div></div>
                </div>
                <label class="toggle-check mt-2">
                    <input type="checkbox" name="IsActive" value="true" @(Model.IsActive?"checked":"")/>
                    <span>نمایش داده شود</span>
                </label>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="tahila-card p-4 mb-4">
                <h6 style="font-weight:700;margin-bottom:1rem;color:var(--gray-light)">تصاویر قبل/بعد</h6>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:1rem">
                    @if (!string.IsNullOrEmpty(Model.BeforeImageUrl))
                    { <img src="@Model.BeforeImageUrl" style="width:100%;height:80px;object-fit:cover;border-radius:8px;opacity:.7"/> }
                    @if (!string.IsNullOrEmpty(Model.AfterImageUrl))
                    { <img src="@Model.AfterImageUrl" style="width:100%;height:80px;object-fit:cover;border-radius:8px"/> }
                </div>
                <div style="margin-bottom:.8rem">
                    <div style="color:var(--gray);font-size:.8rem;margin-bottom:4px">تصویر قبل:</div>
                    <input type="file" name="beforeFile" accept="image/*" style="font-size:.82rem;margin-bottom:4px"/>
                    <input name="BeforeImageUrl" value="@Model.BeforeImageUrl" placeholder="یا URL"/>
                </div>
                <div>
                    <div style="color:var(--gray);font-size:.8rem;margin-bottom:4px">تصویر بعد:</div>
                    <input type="file" name="afterFile" accept="image/*" style="font-size:.82rem;margin-bottom:4px"/>
                    <input name="AfterImageUrl" value="@Model.AfterImageUrl" placeholder="یا URL"/>
                </div>
            </div>
            <button type="submit" class="btn-primary-tahila w-100"><i class="fas fa-save me-2"></i>ذخیره تغییرات</button>
        </div>
    </div>
</form>
