@model IEnumerable<Tahila.Domain.Entities.Slider>
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div></div>
    <a href="/Admin/Sliders/Create" class="btn-primary-tahila"><i class="fas fa-plus me-2"></i>اسلایدر جدید</a>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="tahila-card">
                <img src="@item.ImagePath" alt="@item.Title" style="height:180px;object-fit:cover;width:100%"/>
                <div class="card-body p-3">
                    <h6 style="font-weight:700">@item.Title</h6>
                    <p style="color:var(--gray);font-size:.85rem">@item.SubTitle</p>
                    <div class="d-flex gap-2 align-items-center justify-content-between mt-2">
                        @if (item.IsActive) { <span class="badge-active">فعال</span> } else { <span class="badge-inactive">غیرفعال</span> }
                        <div class="d-flex gap-2">
                            <a href="/Admin/Sliders/Edit/@item.Id" style="color:var(--primary)"><i class="fas fa-edit"></i></a>
                            <form method="post" action="/Admin/Sliders/Delete/@item.Id" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="background:none;border:none;color:#ef4444;cursor:pointer"
                                        onclick="return confirm('حذف شود؟')"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
