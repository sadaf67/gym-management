@model Tahila.Domain.Entities.Schedule
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["PageTitle"] = "ویرایش برنامه"; }

<div class="tahila-card p-4" style="max-width:500px">
    <form method="post" class="form-tahila">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id"/>
        <input type="hidden" asp-for="CreatedAt"/>
        <div class="row g-3">
            <div class="col-12"><label>کلاس *</label><select class="form-select" asp-for="ClassId" asp-items="ViewBag.Classes" required></select></div>
            <div class="col-12"><label>روز هفته *</label><select class="form-select" asp-for="DayOfWeek" asp-items="ViewBag.Days" required></select></div>
            <div class="col-6"><label>ساعت شروع *</label><input class="form-control" type="time" asp-for="StartTime" required/></div>
            <div class="col-6"><label>ساعت پایان *</label><input class="form-control" type="time" asp-for="EndTime" required/></div>
            <div class="col-12 d-flex align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActive"/>
                    <label class="form-check-label" for="isActive" style="color:var(--gray-light)">فعال</label>
                </div>
            </div>
            <div class="col-12 d-flex gap-3 mt-2">
                <button type="submit" class="btn-primary-tahila"><i class="fas fa-save me-2"></i>ذخیره</button>
                <a href="/Admin/Schedule" class="btn-outline-tahila">انصراف</a>
            </div>
        </div>
    </form>
</div>
