@model Tahila.Domain.Entities.Coach
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["PageTitle"] = "مربی جدید"; }

<div class="tahila-card p-4" style="max-width:700px">
    <form method="post" enctype="multipart/form-data" class="form-tahila">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6"><label>نام و نام خانوادگی *</label><input class="form-control" asp-for="FullName" required/></div>
            <div class="col-md-6"><label>تخصص</label><input class="form-control" asp-for="Specialty" placeholder="مثال: بدنسازی، یوگا"/></div>
            <div class="col-12"><label>بیوگرافی</label><textarea class="form-control" asp-for="Bio" rows="4"></textarea></div>
            <div class="col-md-6"><label>اینستاگرام</label><input class="form-control" asp-for="Instagram"/></div>
            <div class="col-md-3"><label>ترتیب</label><input class="form-control" type="number" asp-for="Order" value="0"/></div>
            <div class="col-md-3 d-flex align-items-end pb-1">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActive" checked/>
                    <label class="form-check-label" for="isActive" style="color:var(--gray-light)">فعال</label>
                </div>
            </div>
            <div class="col-12"><label>تصویر مربی</label><input type="file" class="form-control" name="imageFile" accept="image/*"/></div>
            <div class="col-12 d-flex gap-3 mt-2">
                <button type="submit" class="btn-primary-tahila"><i class="fas fa-save me-2"></i>ذخیره</button>
                <a href="/Admin/Coaches" class="btn-outline-tahila">انصراف</a>
            </div>
        </div>
    </form>
</div>
