@model IEnumerable<Tahila.Domain.Entities.GalleryItem>
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["PageTitle"] = "گالری"; }

<div class="d-flex justify-content-end mb-4">
    <a href="/Admin/Gallery/Create" class="btn-primary-tahila"><i class="fas fa-plus me-2"></i>آپلود جدید</a>
</div>

<div class="row g-3">
@foreach (var item in Model)
{
    <div class="col-6 col-md-4 col-lg-3">
        <div class="tahila-card" style="overflow:hidden">
            @if (item.IsVideo)
            { <div style="height:140px;background:#000;display:flex;align-items:center;justify-content:center"><i class="fas fa-play-circle" style="font-size:3rem;color:var(--primary)"></i></div> }
            else
            { <img src="@item.FilePath" style="width:100%;height:140px;object-fit:cover"/> }
            <div class="p-2">
                <div style="font-size:.85rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@item.Title</div>
                @if (!string.IsNullOrEmpty(item.Category))
                { <div style="font-size:.75rem;color:var(--primary)">@item.Category</div> }
                <div class="d-flex justify-content-between align-items-center mt-2">
                    @if(item.IsActive){<span class="badge-active" style="font-size:.7rem">فعال</span>}else{<span class="badge-inactive" style="font-size:.7rem">غیرفعال</span>}
                    <form method="post" action="/Admin/Gallery/Delete/@item.Id" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:.85rem" onclick="return confirm('حذف شود؟')"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
</div>
