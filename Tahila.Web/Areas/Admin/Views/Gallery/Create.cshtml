@model Tahila.Domain.Entities.GalleryItem
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["PageTitle"] = "آپلود جدید"; }

<div class="tahila-card p-4" style="max-width:600px">
    <form method="post" enctype="multipart/form-data" class="form-tahila">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-8"><label>عنوان *</label><input class="form-control" asp-for="Title" required/></div>
            <div class="col-md-4"><label>دسته‌بندی</label><input class="form-control" asp-for="Category" placeholder="مثال: تجهیزات"/></div>
            <div class="col-md-4"><label>ترتیب</label><input class="form-control" type="number" asp-for="Order" value="0"/></div>
            <div class="col-md-4 d-flex align-items-end pb-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActive" checked/>
                    <label class="form-check-label" for="isActive" style="color:var(--gray-light)">فعال</label>
                </div>
            </div>
            <div class="col-12">
                <label>فایل (تصویر یا ویدیو) *</label>
                <input type="file" class="form-control" name="file" accept="image/*,video/mp4,video/webm" required/>
                <small style="color:var(--gray)">فرمت‌های مجاز: jpg, png, webp, mp4, webm</small>
            </div>
            <div class="col-12 d-flex gap-3 mt-2">
                <button type="submit" class="btn-primary-tahila"><i class="fas fa-upload me-2"></i>آپلود</button>
                <a href="/Admin/Gallery" class="btn-outline-tahila">انصراف</a>
            </div>
        </div>
    </form>
</div>
