@using Tahila.Application.Services.Interfaces
@inject ISiteSettingService SiteSettingService
@{
    var settings = await SiteSettingService.GetSettingsAsync();
    var currentPath = Context.Request.Path.ToString();
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>پنل مدیریت | @settings.SiteName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/tahila.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="admin-sidebar" id="adminSidebar">
    <div class="admin-logo">
        <i class="fas fa-dumbbell" style="color:var(--primary)"></i>
        <span class="me-2">@settings.SiteName</span>
        <div style="font-size:.7rem;color:var(--gray);margin-top:2px">پنل مدیریت</div>
    </div>

    <nav class="admin-nav mt-2">
        <div class="nav-group-title">اصلی</div>
        <div class="nav-item">
            <a href="/Admin/Dashboard" class="@(currentPath.Contains("/Admin/Dashboard") || currentPath == "/Admin" ? "active" : "")">
                <i class="fas fa-chart-pie"></i> داشبورد
            </a>
        </div>

        <div class="nav-group-title">محتوا</div>
        <div class="nav-item">
            <a href="/Admin/SiteSettings" class="@(currentPath.Contains("/Admin/SiteSettings") ? "active" : "")">
                <i class="fas fa-gear"></i> تنظیمات سایت
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Sliders" class="@(currentPath.Contains("/Admin/Sliders") ? "active" : "")">
                <i class="fas fa-images"></i> اسلایدر
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Gallery" class="@(currentPath.Contains("/Admin/Gallery") ? "active" : "")">
                <i class="fas fa-photo-film"></i> گالری
            </a>
        </div>

        <div class="nav-group-title">باشگاه</div>
        <div class="nav-item">
            <a href="/Admin/Classes" class="@(currentPath.Contains("/Admin/Classes") ? "active" : "")">
                <i class="fas fa-dumbbell"></i> کلاس‌ها
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Coaches" class="@(currentPath.Contains("/Admin/Coaches") ? "active" : "")">
                <i class="fas fa-user-tie"></i> مربیان
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Schedule" class="@(currentPath.Contains("/Admin/Schedule") ? "active" : "")">
                <i class="fas fa-calendar-week"></i> برنامه هفتگی
            </a>
        </div>

        <div class="nav-group-title">مالی</div>
        <div class="nav-item">
            <a href="/Admin/Plans" class="@(currentPath.Contains("/Admin/Plans") ? "active" : "")">
                <i class="fas fa-tags"></i> پلن‌های عضویت
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Payments" class="@(currentPath.Contains("/Admin/Payments") ? "active" : "")">
                <i class="fas fa-credit-card"></i> پرداخت‌ها
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Members" class="@(currentPath.Contains("/Admin/Members") ? "active" : "")">
                <i class="fas fa-users"></i> اعضا
            </a>
        </div>

        <div class="nav-group-title">محتوای دیجیتال</div>
        <div class="nav-item">
            <a href="/Admin/Nutrition" class="@(currentPath.Contains("/Admin/Nutrition") ? "active" : "")">
                <i class="fas fa-leaf"></i> مقالات تغذیه
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Workout" class="@(currentPath.Contains("/Admin/Workout") ? "active" : "")">
                <i class="fas fa-dumbbell"></i> مقالات تمرین
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/OfflineClasses" class="@(currentPath.Contains("/Admin/OfflineClasses") ? "active" : "")">
                <i class="fas fa-play-circle"></i> کلاس‌های آفلاین
            </a>
        </div>
        <div class="nav-item">
            <a href="/Admin/Transformations" class="@(currentPath.Contains("/Admin/Transformations") ? "active" : "")">
                <i class="fas fa-trophy"></i> داستان‌های موفقیت
            </a>
        </div>

        <div class="nav-group-title">سیستم</div>
        <div class="nav-item">
            <a href="/" target="_blank"><i class="fas fa-external-link-alt"></i> مشاهده سایت</a>
        </div>
        <div class="nav-item">
            <a href="/account/logout"><i class="fas fa-sign-out-alt"></i> خروج</a>
        </div>
    </nav>
</div>

<div class="admin-content">
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebarToggle" class="d-lg-none" style="background:none;border:1px solid #333;padding:6px 10px;border-radius:8px;color:#fff">
                <i class="fas fa-bars"></i>
            </button>
            <h5 style="margin:0;font-weight:700">@ViewData["PageTitle"]</h5>
        </div>
        <div style="color:var(--gray);font-size:.85rem">
            <i class="fas fa-user-circle me-1" style="color:var(--primary)"></i>
            @User.Identity?.Name
        </div>
    </div>

    <div class="admin-page">
        @if (TempData["Success"] != null)
        {
            <div class="alert" style="background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:#22c55e;border-radius:12px;padding:12px 16px">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#ef4444;border-radius:12px;padding:12px 16px">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('sidebarToggle')?.addEventListener('click', () => {
  document.getElementById('adminSidebar').classList.toggle('open');
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
