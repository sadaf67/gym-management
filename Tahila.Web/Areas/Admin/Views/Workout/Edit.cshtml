@model Tahila.Domain.Entities.WorkoutArticle
@{ ViewData["PageTitle"] = "ویرایش مقاله تمرین"; }

@section Styles {
<style>
.form-field{margin-bottom:1.4rem}.form-field label{display:block;font-weight:700;font-size:.88rem;margin-bottom:.5rem;color:var(--gray-light)}
.form-field input,.form-field textarea{width:100%;background:var(--dark-bg);border:1px solid var(--dark-border);border-radius:10px;padding:10px 14px;color:var(--white);font-family:Vazirmatn,sans-serif;font-size:.9rem}
.form-field input:focus,.form-field textarea:focus{outline:none;border-color:#6366f1}
.toggle-check{display:flex;align-items:center;gap:10px;cursor:pointer}
.toggle-check input[type=checkbox]{width:20px;height:20px;accent-color:#6366f1}
</style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="/Admin/Workout" style="color:var(--gray);font-size:.9rem"><i class="fas fa-arrow-right me-2"></i>بازگشت</a>
    <a href="/workout/@Model.Slug" target="_blank" style="color:#6366f1;font-size:.85rem"><i class="fas fa-external-link-alt me-1"></i>مشاهده</a>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id"/>
    <input type="hidden" name="ViewCount" value="@Model.ViewCount"/>
    <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("o")"/>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="tahila-card p-4">
                <div class="form-field"><label>عنوان *</label><input name="Title" value="@Model.Title" required/></div>
                <div class="form-field"><label>خلاصه</label><textarea name="Summary" rows="3">@Model.Summary</textarea></div>
                <div class="form-field"><label>محتوا (HTML)</label><textarea name="Content" rows="24">@Model.Content</textarea></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="tahila-card p-4 mb-4">
                <h6 style="font-weight:700;margin-bottom:1.2rem;color:var(--gray-light)">تنظیمات</h6>
                <div class="form-field"><label>دسته‌بندی</label><input name="Category" value="@Model.Category" required/></div>
                <div class="form-field"><label>نویسنده</label><input name="AuthorName" value="@Model.AuthorName"/></div>
                <div class="form-field"><label>زمان مطالعه</label><input type="number" name="ReadMinutes" value="@Model.ReadMinutes" min="1"/></div>
                <input type="hidden" name="Slug" value="@Model.Slug"/>
                <div class="form-field"><label>برچسب‌ها</label><input name="Tags" value="@Model.Tags"/></div>
                <div class="form-field"><label>ترتیب</label><input type="number" name="Order" value="@Model.Order" min="0"/></div>
                <div class="d-flex flex-column gap-3 mb-3">
                    <label class="toggle-check"><input type="checkbox" name="IsPublished" value="true" @(Model.IsPublished?"checked":"")/>منتشر شده</label>
                    <label class="toggle-check"><input type="checkbox" name="IsFeatured" value="true" @(Model.IsFeatured?"checked":"")/>⭐ مقاله ویژه</label>
                </div>
            </div>
            <div class="tahila-card p-4 mb-4">
                <h6 style="font-weight:700;margin-bottom:1rem;color:var(--gray-light)">تصویر</h6>
                @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                { <img src="@Model.ThumbnailUrl" style="width:100%;border-radius:10px;margin-bottom:8px;max-height:120px;object-fit:cover"/> }
                <input type="file" name="thumbnailFile" accept="image/*" style="font-size:.85rem;margin-bottom:8px"/>
                <input name="ThumbnailUrl" value="@Model.ThumbnailUrl" placeholder="یا URL"/>
            </div>
            <button type="submit" class="btn-primary-tahila w-100"><i class="fas fa-save me-2"></i>ذخیره تغییرات</button>
        </div>
    </div>
</form>
