@model IEnumerable<Tahila.Domain.Entities.GymClass>
@{ ViewData["Title"] = "کلاس‌ها"; }

<section style="padding:80px 0 40px">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="section-title">کلاس‌های <span>تخصصی</span></h1>
            <div class="section-divider mx-auto"></div>
            <p style="color:var(--gray);max-width:600px;margin:0 auto">با بهترین مربیان و پیشرفته‌ترین تجهیزات، سفر تناسب اندامت رو شروع کن</p>
        </div>

        <div class="row g-4">
            @foreach (var c in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="tahila-card h-100">
                        @if (!string.IsNullOrEmpty(c.ImagePath))
                        { <img src="@c.ImagePath" alt="@c.Name"/> }
                        else
                        { <div style="height:220px;background:linear-gradient(135deg,rgba(255,45,120,.15),#1a1a1a);display:flex;align-items:center;justify-content:center"><i class="@(c.IconClass ?? "fas fa-dumbbell")" style="font-size:4rem;color:var(--primary);opacity:.7"></i></div> }
                        <div class="card-body">
                            <h5 class="card-title">@c.Name</h5>
                            <p class="card-text">@c.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3" style="border-top:1px solid var(--dark-border);padding-top:12px">
                                @if (c.Coach != null)
                                { <span style="color:var(--gray);font-size:.85rem"><i class="fas fa-user me-1" style="color:var(--primary)"></i>@c.Coach.FullName</span> }
                                <span style="color:var(--gray);font-size:.85rem"><i class="fas fa-users me-1" style="color:var(--primary)"></i>ظرفیت @c.Capacity</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--gray)">
                <i class="fas fa-dumbbell" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">به زودی کلاس‌ها اضافه می‌شوند</p>
            </div>
        }
    </div>
</section>
