@using Tahila.Application.Services.Interfaces
@inject ISiteSettingService SiteSettingService
@{
    var settings = await SiteSettingService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="@(settings.SiteDescription ?? settings.SiteName)"/>
    <meta name="theme-color" content="#0D0D0D"/>
    <!-- Open Graph -->
    <meta property="og:title" content="@ViewData["Title"] | @settings.SiteName"/>
    <meta property="og:description" content="@(settings.SiteDescription ?? settings.SiteName)"/>
    <meta property="og:type" content="website"/>
    <meta property="og:locale" content="fa_IR"/>
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json"/>
    <link rel="apple-touch-icon" href="/img/logo.svg"/>
    <title>@ViewData["Title"] | @settings.SiteName</title>
    <link rel="preload" href="/img/logo-loader.svg" as="image"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/tahila.css" asp-append-version="true"/>
    @if (!string.IsNullOrEmpty(settings.PrimaryColor) && settings.PrimaryColor != "#FF2D78")
    {
        <style>:root { --primary: @settings.PrimaryColor; --primary-dark: @settings.PrimaryColor; }</style>
    }

    <style>
    /* ══════════════════════════════════════════
       PAGE LOADER
    ══════════════════════════════════════════ */
    #tahila-loader {
        position: fixed; inset: 0; z-index: 99999;
        background: #0D0D0D;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 0;
        transition: opacity .55s ease, visibility .55s ease;
    }
    #tahila-loader.hide {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    /* logo image */
    .loader-logo {
        width: 260px;
        animation: loaderPop .7s cubic-bezier(.34,1.56,.64,1) both;
    }

    /* progress bar */
    .loader-bar-wrap {
        width: 200px;
        height: 3px;
        background: #1e1e1e;
        border-radius: 3px;
        margin-top: 28px;
        overflow: hidden;
    }
    .loader-bar {
        height: 100%;
        width: 0%;
        border-radius: 3px;
        background: linear-gradient(90deg, #FF2D78, #FF6BAE);
        animation: loaderFill 1.6s cubic-bezier(.4,0,.2,1) forwards;
    }

    /* pulse ring */
    .loader-ring {
        width: 80px; height: 80px;
        border-radius: 50%;
        border: 2px solid rgba(255,45,120,.15);
        position: absolute;
        animation: loaderRing 1.8s ease-out infinite;
    }
    .loader-ring:nth-child(2) { animation-delay: .6s; }
    .loader-ring:nth-child(3) { animation-delay: 1.2s; }

    .loader-rings {
        position: absolute;
        display: flex; align-items: center; justify-content: center;
    }

    @@keyframes loaderPop {
        0%   { opacity:0; transform: scale(.7) translateY(20px); }
        100% { opacity:1; transform: scale(1)  translateY(0);    }
    }
    @@keyframes loaderFill {
        0%   { width: 0%; }
        60%  { width: 75%; }
        100% { width: 100%; }
    }
    @@keyframes loaderRing {
        0%   { transform: scale(.6); opacity: .6; }
        100% { transform: scale(2);  opacity: 0;  }
    }

    /* body locked while loading */
    body.loading { overflow: hidden; }

    /* ══════════════════════════════════════════
       DARK / LIGHT MODE
    ══════════════════════════════════════════ */
    body.light-mode {
        --dark-bg: #f4f6f9; --dark-card: #ffffff; --dark-border: #e2e8f0;
        --white: #0f172a; --gray-light: #374151; --gray: #6b7280;
        background: var(--dark-bg); color: var(--white);
    }
    body.light-mode .navbar-tahila { background: rgba(255,255,255,.95); border-bottom-color: #e2e8f0; }
    body.light-mode .footer-tahila { background: #1e293b; }

    #theme-toggle {
        background: none; border: 1px solid var(--dark-border); color: var(--gray);
        border-radius: 50%; width: 36px; height: 36px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all .2s; font-size: .85rem;
    }
    #theme-toggle:hover { border-color: var(--primary); color: var(--primary); }

    /* ══════════════════════════════════════════
       CHATBOT
    ══════════════════════════════════════════ */
    #chatbot-btn {
        position: fixed; bottom: 28px; left: 28px; z-index: 9000;
        width: 56px; height: 56px; border-radius: 50%;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        border: none; cursor: pointer; box-shadow: 0 8px 24px rgba(34,197,94,.35);
        display: flex; align-items: center; justify-content: center;
        transition: transform .2s, box-shadow .2s;
        animation: chatPulse 3s ease-in-out infinite;
    }
    #chatbot-btn:hover { transform: scale(1.1); box-shadow: 0 12px 32px rgba(34,197,94,.5); }
    #chatbot-btn i { color: #fff; font-size: 1.3rem; }

    #chatbot-window {
        position: fixed; bottom: 96px; left: 28px; z-index: 9000;
        width: 340px; max-height: 480px; border-radius: 20px;
        background: var(--dark-card); border: 1px solid var(--dark-border);
        box-shadow: 0 20px 60px rgba(0,0,0,.4);
        display: none; flex-direction: column; overflow: hidden;
    }
    #chatbot-window.open { display: flex; animation: chatSlideUp .3s ease both; }
    .chat-header { background: linear-gradient(135deg,#22c55e,#16a34a); padding: 14px 16px; }
    .chat-header h6 { color: #fff; margin: 0; font-weight: 700; font-size: .95rem; }
    .chat-header p { color: rgba(255,255,255,.7); margin: 0; font-size: .75rem; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
    .chat-msg { max-width: 85%; padding: 8px 12px; border-radius: 12px; font-size: .85rem; line-height: 1.5; }
    .chat-msg.bot { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: var(--gray-light); align-self: flex-start; border-radius: 12px 12px 12px 2px; }
    .chat-msg.user { background: var(--primary); color: #fff; align-self: flex-end; border-radius: 12px 12px 2px 12px; }
    .chat-input-row { padding: 12px; border-top: 1px solid var(--dark-border); display: flex; gap: 8px; }
    .chat-input-row input { flex: 1; background: var(--dark-bg); border: 1px solid var(--dark-border); border-radius: 20px; padding: 8px 14px; color: var(--white); font-family: Vazirmatn,sans-serif; font-size: .85rem; }
    .chat-input-row input:focus { outline: none; border-color: #22c55e; }
    .chat-input-row button { background: #22c55e; border: none; border-radius: 50%; width: 36px; height: 36px; color: #fff; cursor: pointer; flex-shrink: 0; }
    .chat-quick { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 10px; }
    .chat-quick button { background: rgba(34,197,94,.08); border: 1px solid rgba(34,197,94,.2); color: #22c55e; border-radius: 16px; padding: 4px 10px; font-size: .75rem; cursor: pointer; font-family: Vazirmatn,sans-serif; transition: all .2s; }
    .chat-quick button:hover { background: rgba(34,197,94,.2); }

    @@keyframes chatPulse {
        0%,100% { box-shadow: 0 8px 24px rgba(34,197,94,.35); }
        50% { box-shadow: 0 8px 32px rgba(34,197,94,.6); }
    }
    @@keyframes chatSlideUp {
        from { opacity:0; transform: translateY(20px); }
        to   { opacity:1; transform: translateY(0); }
    }

    /* ══════════════════════════════════════════
       COUNTER ANIMATION
    ══════════════════════════════════════════ */
    [data-counter] { display: inline-block; }

    /* ══════════════════════════════════════════
       NAVBAR LOGO
    ══════════════════════════════════════════ */
    .navbar-logo-img {
        height: 42px;
        width: auto;
        display: block;
        transition: transform .3s;
    }
    .navbar-logo-img:hover { transform: scale(1.05); }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
