<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="~/js/tahila.js" asp-append-version="true"></script>

<script>
// ── Page Loader ──────────────────────────────────────────────
(function () {
    const loader = document.getElementById('tahila-loader');
    function hideLoader() { loader.classList.add('hide'); document.body.classList.remove('loading'); }
    if (document.readyState === 'complete') setTimeout(hideLoader, 1700);
    else window.addEventListener('load', () => setTimeout(hideLoader, 1700));
    setTimeout(hideLoader, 3000);
}());

// ── Dark / Light Mode ────────────────────────────────────────
(function () {
    const btn = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    const saved = localStorage.getItem('tahila-theme') || 'dark';
    if (saved === 'light') { document.body.classList.add('light-mode'); if(icon) icon.className = 'fas fa-sun'; }
    btn?.addEventListener('click', () => {
        const isLight = document.body.classList.toggle('light-mode');
        if(icon) icon.className = isLight ? 'fas fa-sun' : 'fas fa-moon';
        localStorage.setItem('tahila-theme', isLight ? 'light' : 'dark');
    });
}());

// ── Counter Animation ────────────────────────────────────────
(function () {
    const counters = document.querySelectorAll('[data-counter]');
    if (!counters.length) return;
    const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (!e.isIntersecting) return;
            const el = e.target;
            const target = parseFloat(el.dataset.counter);
            const isFloat = el.dataset.counter.includes('.');
            let start = null;
            function step(ts) {
                if (!start) start = ts;
                const p = Math.min((ts - start) / 1400, 1);
                const ease = 1 - Math.pow(1 - p, 3);
                el.textContent = isFloat ? (ease * target).toFixed(1) : Math.floor(ease * target).toLocaleString('fa-IR');
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
            observer.unobserve(el);
        });
    }, { threshold: 0.4 });
    counters.forEach(c => observer.observe(c));
}());

// ── Chatbot ──────────────────────────────────────────────────
const chatKB = {
    'کاهش وزن':  'برای کاهش وزن علمی:\n• کالری دریافتی رو ۵۰۰ کمتر از TDEE کن\n• روزانه ۱.۸-۲ گرم پروتئین به ازای هر کیلو\n• ۳-۴ روز تمرین مقاومتی در هفته\n👉 /bmi — BMI خودت رو محاسبه کن',
    'پروتئین':   'بهترین منابع پروتئین:\n🥩 سینه مرغ، تخم‌مرغ، ماهی\n🥛 پنیر کم‌چرب، شیر\n🌱 عدس، نخود، لوبیا\nهدف: روزانه ۱.۶-۲.۲g × وزن بدن',
    'تمرین':     'پیشنهاد تمرینی ۴ روزه:\n• روز ۱: سینه + سه‌سر\n• روز ۲: پشت + دوسر\n• روز ۳: پا + سرشانه\n• روز ۴: کل بدن\n👉 /offline-classes — کلاس‌های ویدیویی',
    'bmi':       'BMI سالم: ۱۸.۵ تا ۲۴.۹\n• زیر ۱۸.۵: کمبود وزن\n• ۱۸.۵-۲۴.۹: نرمال ✅\n• ۲۵-۲۹.۹: اضافه وزن\n👉 /bmi — محاسبه دقیق',
    'رژیم':      'رژیم‌های اثبات‌شده:\n🌿 مدیترانه‌ای — سلامت عمومی\n⚡ کتوژنیک — کاهش وزن سریع\n💪 پروتئین بالا — عضله‌سازی\n👉 /nutrition — مقالات تخصصی',
    'آب':        'آب‌رسانی:\n💧 روزانه ۸-۱۰ لیوان\n🏃 حین تمرین: هر ۲۰ دقیقه ۲۴۰ml\nکم‌آبی → ۳۰٪ افت عملکرد!',
    'خواب':      'خواب و تغذیه:\n😴 ۷-۸ ساعت ضروری\n🌙 آخرین وعده ۲ ساعت قبل از خواب\nهورمون رشد در خواب ترشح می‌شه!',
    'کالری':     'محاسبه کالری:\nمردان: BMR = ۸۸ + ۱۳.۴×وزن + ۴.۸×قد - ۵.۷×سن\nزنان: BMR = ۴۴۷ + ۹.۲×وزن + ۳.۱×قد - ۴.۳×سن\n👉 /bmi — همه چیز رو خودکار محاسبه می‌کنه',
};
function getBotReply(t) {
    const l = t.toLowerCase();
    for (const [k, v] of Object.entries(chatKB)) {
        if (l.includes(k.toLowerCase())) return v;
    }
    if (/سلام|درود|هی/.test(l)) return 'سلام! 😊 خوش اومدی! چه سوالی داری؟';
    if (/ممنون|مرسی|تشکر/.test(l)) return 'خواهش می‌کنم! 🙏 موفق باشی در مسیر سلامتی‌ات!';
    return 'این سوال رو هنوز بلد نیستم جواب بدم 😅\nاز اینجا کمک بگیر:\n👉 /nutrition — مقالات تغذیه\n👉 /bmi — محاسبه BMI';
}
function addMsg(text, type) {
    const msgs = document.getElementById('chatMessages');
    if (!msgs) return;
    const div = document.createElement('div');
    div.className = 'chat-msg ' + type;
    div.style.whiteSpace = 'pre-line';
    div.innerHTML = text.replace(/👉 (\/\S+)/g, '👉 <a href="$1" style="color:#22c55e">$1</a>');
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
}
function sendChat() {
    const input = document.getElementById('chatInput');
    const txt = input.value.trim();
    if (!txt) return;
    addMsg(txt, 'user');
    input.value = '';
    const qb = document.getElementById('quickBtns');
    if (qb) qb.style.display = 'none';
    setTimeout(() => addMsg(getBotReply(txt), 'bot'), 500);
}
function sendQuick(txt) {
    addMsg(txt, 'user');
    const qb = document.getElementById('quickBtns');
    if (qb) qb.style.display = 'none';
    setTimeout(() => addMsg(getBotReply(txt), 'bot'), 500);
}
document.getElementById('chatbot-btn')?.addEventListener('click', () => {
    document.getElementById('chatbot-window')?.classList.toggle('open');
});
document.getElementById('chatInput')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') sendChat();
});

// ── PWA Service Worker ───────────────────────────────────────
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(()=>{}));
}
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
