@model Tahila.Domain.Entities.SiteSetting
@{ ViewData["Title"] = "تماس با ما"; }

<section style="padding:80px 0 40px">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="section-title">تماس <span>با ما</span></h1>
            <div class="section-divider mx-auto"></div>
        </div>

        @if (TempData["ContactSuccess"] != null)
        {
            <div class="alert text-center mb-4" style="background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:#22c55e;border-radius:12px;padding:16px">
                <i class="fas fa-check-circle me-2"></i>@TempData["ContactSuccess"]
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-5">
                <div class="contact-info-item">
                    <div class="icon"><i class="fas fa-phone"></i></div>
                    <div>
                        <div style="font-weight:700;margin-bottom:4px">تلفن</div>
                        <div style="color:var(--gray)">@Model.Phone</div>
                        @if (!string.IsNullOrEmpty(Model.Phone2))
                        { <div style="color:var(--gray)">@Model.Phone2</div> }
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="icon"><i class="fas fa-location-dot"></i></div>
                    <div>
                        <div style="font-weight:700;margin-bottom:4px">آدرس</div>
                        <div style="color:var(--gray)">@Model.Address</div>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <div style="font-weight:700;margin-bottom:4px">ساعات کار</div>
                        <div style="color:var(--gray)">@Model.WorkingHours</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="contact-info-item">
                        <div class="icon"><i class="fas fa-envelope"></i></div>
                        <div>
                            <div style="font-weight:700;margin-bottom:4px">ایمیل</div>
                            <div style="color:var(--gray)">@Model.Email</div>
                        </div>
                    </div>
                }
                <div class="d-flex gap-3 mt-3">
                    @if (!string.IsNullOrEmpty(Model.Instagram))
                    { <a href="@Model.Instagram" target="_blank" style="width:45px;height:45px;background:rgba(255,45,120,.1);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:1.2rem;text-decoration:none"><i class="fab fa-instagram"></i></a> }
                    @if (!string.IsNullOrEmpty(Model.Telegram))
                    { <a href="@Model.Telegram" target="_blank" style="width:45px;height:45px;background:rgba(255,45,120,.1);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:1.2rem;text-decoration:none"><i class="fab fa-telegram"></i></a> }
                    @if (!string.IsNullOrEmpty(Model.WhatsApp))
                    { <a href="@Model.WhatsApp" target="_blank" style="width:45px;height:45px;background:rgba(255,45,120,.1);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:1.2rem;text-decoration:none"><i class="fab fa-whatsapp"></i></a> }
                </div>
            </div>

            <div class="col-lg-7">
                <div class="tahila-card p-4">
                    <h5 style="font-weight:700;margin-bottom:1.5rem">ارسال پیام</h5>
                    <form method="post" class="form-tahila">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6"><label>نام و نام خانوادگی</label><input class="form-control" name="name" required/></div>
                            <div class="col-md-6"><label>شماره تلفن</label><input class="form-control" name="phone" type="tel" required/></div>
                            <div class="col-12"><label>پیام</label><textarea class="form-control" name="message" rows="5" required></textarea></div>
                            <div class="col-12">
                                <button type="submit" class="btn-primary-tahila"><i class="fas fa-paper-plane me-2"></i>ارسال پیام</button>
                            </div>
                        </div>
                    </form>
                </div>

                @if (!string.IsNullOrEmpty(Model.MapEmbed))
                {
                    <div class="mt-4" style="border-radius:16px;overflow:hidden;border:1px solid var(--dark-border)">
                        @Html.Raw(Model.MapEmbed)
                    </div>
                }
            </div>
        </div>
    </div>
</section>
