@{
    ViewData["Title"] = "مرکز تمرین و ورزش";
    var articles   = ViewBag.Articles   as IEnumerable<Tahila.Domain.Entities.WorkoutArticle> ?? [];
    var featured   = ViewBag.Featured   as IEnumerable<Tahila.Domain.Entities.WorkoutArticle> ?? [];
    var categories = ViewBag.Categories as IEnumerable<string> ?? [];
    string? activeCat = ViewBag.ActiveCat as string;
}

@section Styles {
<style>
.wo-hero { padding:80px 0 50px; background:linear-gradient(135deg,rgba(99,102,241,.08) 0%,rgba(13,13,13,1) 60%); }
.wo-card { background:var(--dark-card);border:1px solid var(--dark-border);border-radius:18px;overflow:hidden;transition:all .3s;height:100%; }
.wo-card:hover { border-color:#6366f1;transform:translateY(-4px);box-shadow:0 16px 40px rgba(99,102,241,.12); }
.wo-thumb { aspect-ratio:16/9;overflow:hidden; }
.wo-thumb img { width:100%;height:100%;object-fit:cover;transition:transform .4s; }
.wo-card:hover .wo-thumb img { transform:scale(1.06); }
.cat-pill { display:inline-block;padding:3px 12px;border-radius:20px;font-size:.72rem;font-weight:700; }
.wo-stat { display:flex;align-items:center;gap:5px;font-size:.78rem;color:var(--gray); }
.cat-filters { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:2rem; }
.cat-filter-btn { padding:7px 18px;border-radius:30px;border:1px solid var(--dark-border);background:transparent;color:var(--gray);font-size:.85rem;cursor:pointer;transition:all .2s;text-decoration:none; }
.cat-filter-btn:hover,.cat-filter-btn.active { border-color:#6366f1;color:#6366f1;background:rgba(99,102,241,.08); }
</style>
}

<section class="wo-hero">
<div class="container">
    <div class="text-center mb-5">
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.2);padding:6px 18px;border-radius:30px;margin-bottom:1rem">
            <i class="fas fa-dumbbell" style="color:#6366f1;font-size:.85rem"></i>
            <span style="color:#6366f1;font-size:.82rem;font-weight:700">مرکز تخصصی تمرین</span>
        </div>
        <h1 class="section-title">علم <span>تمرین</span></h1>
        <div class="section-divider mx-auto"></div>
        <p style="color:var(--gray);max-width:560px;margin:0 auto">راهنمای علمی تمرین، تکنیک صحیح حرکات و برنامه‌های حرفه‌ای برای هر سطح</p>
    </div>

    <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:16px;padding:1.2rem 2rem" class="d-flex justify-content-center flex-wrap gap-3 mb-5">
        <div style="text-align:center;padding:0 1.5rem;border-left:1px solid var(--dark-border)">
            <div style="font-size:1.6rem;font-weight:900;color:#6366f1" data-counter="@articles.Count()">@articles.Count()</div>
            <div style="font-size:.78rem;color:var(--gray)">مقاله تمرینی</div>
        </div>
        <div style="text-align:center;padding:0 1.5rem;border-left:1px solid var(--dark-border)">
            <div style="font-size:1.6rem;font-weight:900;color:var(--primary)" data-counter="@categories.Count()">@categories.Count()</div>
            <div style="font-size:.78rem;color:var(--gray)">دسته‌بندی</div>
        </div>
        <div style="text-align:center;padding:0 1.5rem">
            <div style="font-size:1.6rem;font-weight:900;color:#22c55e">رایگان</div>
            <div style="font-size:.78rem;color:var(--gray)">دسترسی کامل</div>
        </div>
    </div>

    @if (featured.Any())
    {
        <div class="row g-4 mb-5">
            <div class="col-12"><h5 style="font-weight:700;margin-bottom:1.2rem"><i class="fas fa-star me-2" style="color:#f59e0b"></i>مقالات ویژه</h5></div>
            @foreach (var a in featured)
            {
                <div class="col-md-4">
                    <a href="/workout/@a.Slug" style="text-decoration:none">
                        <div class="wo-card" style="background:linear-gradient(135deg,rgba(99,102,241,.08),var(--dark-card));border-color:rgba(99,102,241,.2)">
                            @if (!string.IsNullOrEmpty(a.ThumbnailUrl))
                            { <div class="wo-thumb"><img src="@a.ThumbnailUrl" alt="@a.Title" loading="lazy"/></div> }
                            <div style="padding:1.2rem">
                                <span class="cat-pill" style="background:rgba(99,102,241,.12);color:#6366f1;margin-bottom:.6rem">@a.Category</span>
                                <h6 style="font-weight:700;color:var(--white);line-height:1.5;margin-bottom:.5rem">@a.Title</h6>
                                <p style="color:var(--gray);font-size:.82rem;line-height:1.6;margin-bottom:.8rem">@(a.Summary.Length > 90 ? a.Summary[..90]+"…" : a.Summary)</p>
                                <div class="d-flex gap-3">
                                    <span class="wo-stat"><i class="fas fa-clock"></i>@a.ReadMinutes دقیقه</span>
                                    <span class="wo-stat"><i class="fas fa-eye"></i>@a.ViewCount بازدید</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <div class="cat-filters">
        <a href="/workout" class="cat-filter-btn @(activeCat==null?"active":"")">همه مقالات</a>
        @foreach (var c in categories)
        { <a href="/workout?cat=@Uri.EscapeDataString(c)" class="cat-filter-btn @(activeCat==c?"active":"")">@c</a> }
    </div>

    <div class="row g-4">
        @foreach (var a in articles)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/workout/@a.Slug" style="text-decoration:none">
                    <div class="wo-card">
                        @if (!string.IsNullOrEmpty(a.ThumbnailUrl))
                        { <div class="wo-thumb"><img src="@a.ThumbnailUrl" alt="@a.Title" loading="lazy"/></div> }
                        <div style="padding:1.1rem">
                            <span class="cat-pill mb-2" style="background:rgba(99,102,241,.1);color:#6366f1">@a.Category</span>
                            <h6 style="font-weight:700;color:var(--white);line-height:1.5;margin:.5rem 0">@a.Title</h6>
                            <p style="color:var(--gray);font-size:.82rem;margin-bottom:.8rem;line-height:1.6">@(a.Summary.Length > 80 ? a.Summary[..80]+"…" : a.Summary)</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-3">
                                    <span class="wo-stat"><i class="fas fa-clock"></i>@a.ReadMinutes دقیقه</span>
                                    <span class="wo-stat"><i class="fas fa-eye"></i>@a.ViewCount</span>
                                </div>
                                <span style="color:#6366f1;font-size:.8rem;font-weight:700">بیشتر ←</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    @if (!articles.Any())
    {
        <div class="text-center py-5" style="color:var(--gray)">
            <i class="fas fa-dumbbell" style="font-size:3rem;opacity:.3"></i>
            <p class="mt-3">مقاله‌ای یافت نشد.</p>
        </div>
    }

    <!-- CTA -->
    <div class="text-center mt-5 pt-4">
        <div style="background:linear-gradient(135deg,rgba(99,102,241,.08),rgba(255,45,120,.05));border:1px solid rgba(99,102,241,.2);border-radius:20px;padding:2.5rem">
            <h4 style="font-weight:900;margin-bottom:.5rem">کلاس‌های آفلاین تمرینی</h4>
            <p style="color:var(--gray);margin-bottom:1.5rem">ویدیوهای آموزشی حرفه‌ای — جلسه اول رایگان</p>
            <a href="/offline-classes" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:12px 28px;border-radius:30px;text-decoration:none;font-weight:700">
                <i class="fas fa-play-circle me-2"></i>شروع تمرین
            </a>
        </div>
    </div>
</div>
</section>
