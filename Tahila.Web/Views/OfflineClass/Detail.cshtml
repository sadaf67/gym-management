@model Tahila.Domain.Entities.OfflineClass
@{
    ViewData["Title"] = Model.Title;
    bool hasAccess = (bool)(ViewBag.HasAccess ?? false);
}

@section Styles {
<style>
.detail-hero { padding:60px 0 40px; background:linear-gradient(135deg,rgba(255,45,120,.08),rgba(13,13,13,1)); }
.session-row { background:var(--dark-card);border:1px solid var(--dark-border);border-radius:14px;padding:1rem 1.2rem;
               display:flex;align-items:center;gap:14px;transition:border-color .2s;text-decoration:none;color:inherit; }
.session-row:hover { border-color:var(--primary); }
.session-row.locked { opacity:.7;cursor:default; }
.session-num { width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;
               font-weight:900;font-size:.9rem;flex-shrink:0; }
.session-thumb { width:100px;height:58px;border-radius:8px;object-fit:cover;flex-shrink:0; }
.duration-badge { font-size:.75rem;color:var(--gray);display:flex;align-items:center;gap:4px; }
</style>
}

<section class="detail-hero">
<div class="container">

    <div class="row g-4">
        <!-- ── اطلاعات دوره ── -->
        <div class="col-lg-4">
            <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:20px;overflow:hidden;position:sticky;top:80px">
                <img src="@(Model.ThumbnailUrl ?? "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600&q=80")"
                     alt="@Model.Title" style="width:100%;aspect-ratio:16/9;object-fit:cover"/>
                <div style="padding:1.4rem">
                    <div style="font-size:.75rem;color:var(--primary);font-weight:700;margin-bottom:6px">@Model.Category</div>
                    <h4 style="font-weight:900;margin-bottom:.8rem">@Model.Title</h4>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    { <p style="color:var(--gray);font-size:.88rem;line-height:1.7;margin-bottom:1rem">@Model.Description</p> }

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span style="background:rgba(255,45,120,.1);color:var(--primary);padding:3px 12px;border-radius:20px;font-size:.78rem">
                            <i class="fas fa-signal me-1"></i>@Model.Level
                        </span>
                        <span style="background:rgba(59,130,246,.1);color:#3b82f6;padding:3px 12px;border-radius:20px;font-size:.78rem">
                            <i class="fas fa-film me-1"></i>@Model.Sessions.Count جلسه
                        </span>
                        <span style="background:rgba(34,197,94,.1);color:#22c55e;padding:3px 12px;border-radius:20px;font-size:.78rem">
                            <i class="fas fa-gift me-1"></i>اول رایگان
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CoachName))
                    {
                        <div class="d-flex align-items-center gap-2 mb-3" style="padding:10px;background:rgba(255,255,255,.03);border-radius:10px">
                            @if (!string.IsNullOrEmpty(Model.CoachImage))
                            { <img src="@Model.CoachImage" style="width:38px;height:38px;border-radius:50%;object-fit:cover"/> }
                            else
                            { <div style="width:38px;height:38px;border-radius:50%;background:rgba(255,45,120,.15);display:flex;align-items:center;justify-content:center"><i class="fas fa-user" style="color:var(--primary)"></i></div> }
                            <div>
                                <div style="font-size:.7rem;color:var(--gray)">مربی</div>
                                <div style="font-weight:700;font-size:.9rem">@Model.CoachName</div>
                            </div>
                        </div>
                    }

                    @if (!hasAccess)
                    {
                        <div style="background:rgba(255,45,120,.06);border:1px solid rgba(255,45,120,.2);border-radius:12px;padding:12px;text-align:center;margin-bottom:1rem">
                            <div style="font-size:.82rem;color:var(--gray-light);margin-bottom:8px">
                                <i class="fas fa-lock me-1" style="color:var(--primary)"></i>
                                جلسات بعدی نیاز به اشتراک دارند
                            </div>
                            <a href="/plans" class="btn-primary-tahila w-100 text-center" style="font-size:.85rem;padding:10px">
                                <i class="fas fa-crown me-1"></i>خرید اشتراک
                            </a>
                        </div>
                    }
                    else
                    {
                        <div style="background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);border-radius:12px;padding:10px;text-align:center;font-size:.85rem;color:#22c55e">
                            <i class="fas fa-check-circle me-1"></i>دسترسی کامل به همه جلسات
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── لیست جلسات ── -->
        <div class="col-lg-8">
            <h5 style="font-weight:700;margin-bottom:1.5rem">
                <i class="fas fa-list-ol me-2" style="color:var(--primary)"></i>جلسات دوره
            </h5>

            @if (TempData["NeedSubscription"] != null)
            {
                <div class="alert mb-3" style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);color:#ef4444;border-radius:12px;padding:12px 16px">
                    <i class="fas fa-lock me-2"></i>@TempData["NeedSubscription"]
                </div>
            }

            <div class="d-flex flex-column gap-3">
                @foreach (var session in Model.Sessions.OrderBy(s => s.SessionNumber))
                {
                    bool canWatch = session.IsFree || hasAccess;
                    string href   = canWatch ? $"/offline-classes/watch/{session.Id}" : "/plans";
                    <a href="@href" class="session-row @(canWatch ? "" : "locked")">
                        <!-- شماره جلسه -->
                        <div class="session-num" style="background:@(session.IsFree?"rgba(34,197,94,.15)":"rgba(255,45,120,.1)");color:@(session.IsFree?"#22c55e":"var(--primary)")">
                            @session.SessionNumber
                        </div>

                        <!-- تامبنیل -->
                        <div style="position:relative;flex-shrink:0">
                            <img class="session-thumb"
                                 src="@(session.ThumbnailUrl ?? Model.ThumbnailUrl ?? "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=200&q=70")"
                                 alt="@session.Title"/>
                            @if (canWatch)
                            {
                                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center">
                                    <div style="width:30px;height:30px;background:rgba(255,45,120,.85);border-radius:50%;display:flex;align-items:center;justify-content:center">
                                        <i class="fas fa-play" style="font-size:.65rem;color:#fff;margin-right:-1px"></i>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- اطلاعات -->
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:700;font-size:.95rem;margin-bottom:3px">@session.Title</div>
                            @if (!string.IsNullOrEmpty(session.Description))
                            { <div style="color:var(--gray);font-size:.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@session.Description</div> }
                            <div class="d-flex gap-3 mt-1">
                                <span class="duration-badge"><i class="fas fa-clock"></i>@session.DurationMinutes دقیقه</span>
                                @if (session.IsFree)
                                { <span style="font-size:.75rem;color:#22c55e;font-weight:700"><i class="fas fa-gift me-1"></i>رایگان</span> }
                            </div>
                        </div>

                        <!-- آیکون وضعیت -->
                        <div style="flex-shrink:0">
                            @if (canWatch)
                            { <i class="fas fa-play-circle" style="color:var(--primary);font-size:1.3rem"></i> }
                            else
                            { <i class="fas fa-lock" style="color:var(--gray);font-size:1.1rem"></i> }
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

</div>
</section>
