@model IEnumerable<Tahila.Domain.Entities.OfflineClass>
@{ ViewData["Title"] = "کلاس‌های آفلاین"; }

@section Styles {
<style>
.ol-hero { padding:70px 0 50px; background:linear-gradient(135deg,rgba(255,45,120,.1),rgba(13,13,13,1)); }
.course-card { background:var(--dark-card);border:1px solid var(--dark-border);border-radius:20px;overflow:hidden;transition:all .3s;height:100%; }
.course-card:hover { border-color:var(--primary);transform:translateY(-4px);box-shadow:0 16px 40px rgba(255,45,120,.12); }
.course-thumb { position:relative;overflow:hidden;aspect-ratio:16/9; }
.course-thumb img { width:100%;height:100%;object-fit:cover;transition:transform .4s; }
.course-card:hover .course-thumb img { transform:scale(1.05); }
.free-badge { position:absolute;top:10px;right:10px;background:#22c55e;color:#fff;font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:20px; }
.level-badge { position:absolute;bottom:10px;right:10px;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);color:#fff;font-size:.72rem;padding:3px 10px;border-radius:20px;border:1px solid rgba(255,255,255,.15); }
.session-count { background:rgba(255,45,120,.12);color:var(--primary);font-size:.78rem;font-weight:700;padding:3px 10px;border-radius:20px;display:inline-block; }
.cat-filter { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:2rem; }
.cat-btn { padding:7px 18px;border-radius:30px;border:1px solid var(--dark-border);background:transparent;color:var(--gray);cursor:pointer;font-size:.85rem;transition:all .2s; }
.cat-btn.active, .cat-btn:hover { border-color:var(--primary);color:var(--primary);background:rgba(255,45,120,.08); }
</style>
}

<section class="ol-hero">
<div class="container">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-5">
        <div>
            <h1 class="section-title">کلاس‌های <span>آفلاین</span></h1>
            <div class="section-divider"></div>
            <p style="color:var(--gray)">جلسه اول هر دوره رایگان — ادامه با اشتراک</p>
        </div>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a href="/account/login" class="btn-primary-tahila"><i class="fas fa-user me-2"></i>ورود / ثبت‌نام رایگان</a>
        }
    </div>

    @if (TempData["NeedSubscription"] != null)
    {
        <div class="alert mb-4" style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);color:#ef4444;border-radius:12px;padding:12px 16px">
            <i class="fas fa-lock me-2"></i>@TempData["NeedSubscription"]
            <a href="/plans" style="color:var(--primary);font-weight:700;margin-right:8px">خرید اشتراک ←</a>
        </div>
    }

    <!-- Category filter -->
    @{
        var cats = Model.Select(c => c.Category).Distinct().ToList();
    }
    <div class="cat-filter" id="catFilter">
        <button class="cat-btn active" data-cat="all">همه دوره‌ها</button>
        @foreach (var cat in cats)
        { <button class="cat-btn" data-cat="@cat">@cat</button> }
    </div>

    <!-- Grid -->
    <div class="row g-4" id="coursesGrid">
        @foreach (var cls in Model)
        {
            int freeSessions  = cls.Sessions.Count(s => s.IsFree);
            int paidSessions  = cls.Sessions.Count(s => !s.IsFree);
            var firstSession  = cls.Sessions.OrderBy(s => s.SessionNumber).FirstOrDefault();
            <div class="col-md-6 col-lg-4 course-item" data-cat="@cls.Category">
                <div class="course-card">
                    <a href="/offline-classes/@cls.Id" class="course-thumb d-block">
                        <img src="@(cls.ThumbnailUrl ?? "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600&q=80&fit=crop")"
                             alt="@cls.Title" loading="lazy"/>
                        <span class="free-badge"><i class="fas fa-play me-1"></i>جلسه اول رایگان</span>
                        <span class="level-badge">@cls.Level</span>
                    </a>
                    <div style="padding:1.2rem">
                        <div style="font-size:.75rem;color:var(--primary);font-weight:700;margin-bottom:6px">
                            <i class="fas fa-tag me-1"></i>@cls.Category
                        </div>
                        <h5 style="font-weight:700;margin-bottom:.5rem;line-height:1.4">
                            <a href="/offline-classes/@cls.Id" style="color:var(--white);text-decoration:none">@cls.Title</a>
                        </h5>
                        @if (!string.IsNullOrEmpty(cls.Description))
                        {
                            <p style="color:var(--gray);font-size:.85rem;margin-bottom:1rem;line-height:1.6">
                                @(cls.Description.Length > 100 ? cls.Description[..100] + "…" : cls.Description)
                            </p>
                        }
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(cls.CoachImage))
                                { <img src="@cls.CoachImage" style="width:28px;height:28px;border-radius:50%;object-fit:cover"/> }
                                <span style="font-size:.82rem;color:var(--gray)">@cls.CoachName</span>
                            </div>
                            <span class="session-count"><i class="fas fa-film me-1"></i>@cls.Sessions.Count جلسه</span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            @if (firstSession != null)
                            {
                                <a href="/offline-classes/watch/@firstSession.Id" class="btn-primary-tahila"
                                   style="flex:1;text-align:center;font-size:.85rem;padding:10px">
                                    <i class="fas fa-play me-1"></i>شروع رایگان
                                </a>
                            }
                            <a href="/offline-classes/@cls.Id" class="btn-outline-tahila"
                               style="font-size:.85rem;padding:10px 14px">
                                <i class="fas fa-list"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--gray)">
            <i class="fas fa-video" style="font-size:3rem;opacity:.3"></i>
            <p class="mt-3">به زودی دوره‌های آموزشی اضافه می‌شود.</p>
        </div>
    }

</div>
</section>

@section Scripts {
<script>
document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = btn.dataset.cat;
        document.querySelectorAll('.course-item').forEach(item => {
            item.style.display = (cat === 'all' || item.dataset.cat === cat) ? '' : 'none';
        });
    });
});
</script>
}
