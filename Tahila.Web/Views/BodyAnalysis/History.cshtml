@model IEnumerable<Tahila.Domain.Entities.BodyAnalysis>
@{
    ViewData["Title"] = "تاریخچه تحلیل بدن";
    var items = Model.ToList();
    bool hasChart = items.Count > 1;
}

@section Styles {
<style>
.history-card { background:var(--dark-card);border:1px solid var(--dark-border);border-radius:16px;padding:1.4rem;transition:border-color .3s; }
.history-card:hover { border-color:var(--primary); }
.bmi-mini-bar { height:6px;border-radius:3px;background:linear-gradient(to left,#ef4444,#f97316 30%,#22c55e 50%,#3b82f6 80%);position:relative;margin:8px 0 4px; }
.bmi-mini-dot { position:absolute;top:-3px;width:12px;height:12px;background:#fff;border-radius:50%;transform:translateX(-50%);border:2px solid var(--primary); }
</style>
}

<section style="padding:60px 0 40px">
<div class="container">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-5">
        <div>
            <h1 class="section-title">تاریخچه <span>تحلیل بدن</span></h1>
            <div class="section-divider"></div>
        </div>
        <a href="/bmi" class="btn-primary-tahila"><i class="fas fa-plus me-2"></i>محاسبه جدید</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert mb-4" style="background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);color:#22c55e;border-radius:12px;padding:12px 16px">@TempData["Success"]</div>
    }

    @if (!items.Any())
    {
        <div class="text-center py-5" style="color:var(--gray)">
            <i class="fas fa-chart-line" style="font-size:3rem;opacity:.3"></i>
            <p class="mt-3">هنوز تحلیلی ذخیره نشده.</p>
            <a href="/bmi" class="btn-primary-tahila mt-3 d-inline-block">شروع محاسبه</a>
        </div>
    }

    @if (hasChart)
    {
        <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:16px;padding:1.5rem;margin-bottom:2rem">
            <h6 style="font-weight:700;margin-bottom:1rem"><i class="fas fa-chart-line me-2" style="color:var(--primary)"></i>روند تغییرات</h6>
            <canvas id="bmiChart" height="80"></canvas>
        </div>
    }

    @if (items.Any())
    {
        <div class="row g-3">
            @foreach (var item in items)
            {
                double pos = Math.Clamp((double)(item.BMI - 10f) / 30.0 * 100.0, 0, 100);
                string posStr = pos.ToString("F0");
                string catColor = item.BMI < 18.5f ? "#3b82f6"
                                : item.BMI < 25f   ? "#22c55e"
                                : item.BMI < 30f   ? "#eab308"
                                : item.BMI < 35f   ? "#f97316"
                                : "#ef4444";
                string catBg = catColor + "22";
                <div class="col-md-6 col-lg-4">
                    <div class="history-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span style="font-size:.82rem;color:var(--gray)">@item.CreatedAt.ToString("yyyy/MM/dd — HH:mm")</span>
                            <form method="post" action="/bmi/delete/@item.Id" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="background:none;border:none;color:#ef4444;cursor:pointer" onclick="return confirm('حذف شود؟')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span style="font-size:2.2rem;font-weight:900;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent">@item.BMI</span>
                            <span style="background:@catBg;color:@catColor;padding:3px 12px;border-radius:20px;font-size:.78rem;font-weight:700">@item.BMICategory</span>
                        </div>

                        <div class="bmi-mini-bar">
                            <div class="bmi-mini-dot" style="left:@(posStr)%"></div>
                        </div>

                        <div class="row g-2 mt-2" style="font-size:.82rem">
                            <div class="col-4 text-center" style="border-left:1px solid var(--dark-border)">
                                <div style="color:var(--gray)">وزن</div>
                                <div style="font-weight:700">@item.Weight kg</div>
                            </div>
                            <div class="col-4 text-center" style="border-left:1px solid var(--dark-border)">
                                <div style="color:var(--gray)">قد</div>
                                <div style="font-weight:700">@item.Height cm</div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="color:var(--gray)">چربی</div>
                                <div style="font-weight:700;color:var(--primary)">@(item.BodyFatPercentage.HasValue ? item.BodyFatPercentage + "%" : "—")</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-2" style="font-size:.8rem;color:var(--gray);border-top:1px solid var(--dark-border);padding-top:8px">
                            <span><i class="fas fa-fire me-1" style="color:var(--primary)"></i>BMR: @item.BMR</span>
                            <span>TDEE: @item.TDEE kcal</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
</section>

@if (hasChart)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
        new Chart(document.getElementById('bmiChart'), {
            type: 'line',
            data: {
                labels: [@Html.Raw(string.Join(",", items.AsEnumerable().Reverse().Select(m => $"'{m.CreatedAt:MM/dd}'")))],
                datasets: [
                    { label: 'BMI', data: [@string.Join(",", items.AsEnumerable().Reverse().Select(m => m.BMI))],
                      borderColor:'#FF2D78', backgroundColor:'rgba(255,45,120,.1)', fill:true, tension:0.4, pointBackgroundColor:'#FF2D78', pointRadius:5, yAxisID:'y' },
                    { label: 'وزن', data: [@string.Join(",", items.AsEnumerable().Reverse().Select(m => m.Weight))],
                      borderColor:'#3b82f6', backgroundColor:'rgba(59,130,246,.05)', fill:false, tension:0.4, pointBackgroundColor:'#3b82f6', pointRadius:5, yAxisID:'y1' }
                ]
            },
            options: {
                responsive:true, interaction:{mode:'index',intersect:false},
                plugins:{ legend:{labels:{color:'#888'}} },
                scales: {
                    x:{ticks:{color:'#666'},grid:{color:'#222'}},
                    y:{ticks:{color:'#FF2D78'},grid:{color:'#222'},title:{display:true,text:'BMI',color:'#FF2D78'}},
                    y1:{position:'left',ticks:{color:'#3b82f6'},grid:{drawOnChartArea:false},title:{display:true,text:'وزن',color:'#3b82f6'}}
                }
            }
        });
        </script>
    }
}
