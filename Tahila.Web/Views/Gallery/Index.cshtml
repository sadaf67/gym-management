@model IEnumerable<Tahila.Domain.Entities.GalleryItem>
@{ ViewData["Title"] = "گالری"; }

<section style="padding:80px 0 40px">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="section-title">گالری <span>تصاویر</span></h1>
            <div class="section-divider mx-auto"></div>
        </div>

        @{
            var categories = Model.Where(x => !string.IsNullOrEmpty(x.Category)).Select(x => x.Category!).Distinct().ToList();
        }

        @if (categories.Any())
        {
            <div class="d-flex gap-2 flex-wrap justify-content-center mb-4">
                <button class="gallery-filter active" data-filter="all"
                        style="padding:6px 18px;border-radius:20px;border:1px solid var(--primary);background:var(--primary);color:#fff;cursor:pointer;font-size:.85rem">همه</button>
                @foreach (var cat in categories)
                {
                    <button class="gallery-filter" data-filter="@cat"
                            style="padding:6px 18px;border-radius:20px;border:1px solid var(--dark-border);background:transparent;color:var(--gray-light);cursor:pointer;font-size:.85rem;transition:all .3s">@cat</button>
                }
            </div>
        }

        <div class="gallery-grid" id="galleryGrid">
            @foreach (var item in Model)
            {
                <div class="gallery-item" data-category="@item.Category">
                    @if (item.IsVideo)
                    {
                        <video src="@item.FilePath" style="width:100%;border-radius:12px" controls></video>
                    }
                    else
                    {
                        <img src="@item.FilePath" alt="@item.Title" loading="lazy"/>
                    }
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--gray)">
                <i class="fas fa-images" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-3">تصویری برای نمایش وجود ندارد</p>
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
document.querySelectorAll('.gallery-filter').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.gallery-filter').forEach(b => {
            b.style.background = 'transparent'; b.style.color = 'var(--gray-light)'; b.style.borderColor = 'var(--dark-border)';
        });
        btn.style.background = 'var(--primary)'; btn.style.color = '#fff'; btn.style.borderColor = 'var(--primary)';
        const filter = btn.dataset.filter;
        document.querySelectorAll('.gallery-item').forEach(item => {
            item.style.display = (filter === 'all' || item.dataset.category === filter) ? 'block' : 'none';
        });
    });
});
</script>
}
